// 特案支援金報備系統 — 資料模型
// 雛型階段使用 SQLite；上雲時將 provider 改為 postgresql 並把字串狀態改為 enum。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 人員主檔：帳號 ↔ 據點 ↔ 課別 ↔ 角色
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String // KEZHANG(課長) | SUOZHANG(所長) | BUZHUGUAN(部主管) | STAFF
  storeCode    String // 所別 Dxx
  deptCode     String? // 課別（部主管/staff 可為空）
  systems      String   @default("fund") // 可用系統，逗號分隔（見 src/lib/constants.ts 的 SYSTEM）
  assignedStores String @default("") // 配件中心負責所別，逗號分隔；空=全部
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // 登入防暴力破解：連續失敗達門檻後鎖定一段時間，見 lib/actions.ts login()
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // 改密碼／後台重設密碼時 +1，讓其他裝置的舊 session 失效（見 lib/session.ts）
  sessionVersion Int @default(1)

  submittedCases Case[]        @relation("submitter")
  approvals      ApprovalLog[]

  submittedAccessoryRequests AccessoryRequest[] @relation("accSubmitter")
  accessoryReviews           AccessoryLog[]     @relation("accReviewer")
}

// 案件（申請單）
model Case {
  id          String  @id @default(cuid())
  month       String // 月份 YYYY-MM（自動帶入）
  storeCode   String // 所別（依送單人帶出）
  deptCode    String // 課別（依送單人帶出）
  plateName   String // 領牌名稱
  orderNo     String  @unique // 訂單編號：13碼、第一碼 D、全系統唯一
  categoryId  String? // 特案類別（草稿可留空）
  categoryNo  String? // 類別編號（自動產生；草稿留 null，正式送出才產生。
    // 用 null 而非空字串是因為 unique constraint 允許多個 null 並存，草稿才不會互撞）
  carModel    String // 車名
  description String // 特案內容說明

  // 金額（整數）
  subsidyDeptCourse Int // 所課支援金
  goldMedal         Int // 金牌
  silverMedal       Int // 銀牌
  discountTotal     Int // 折讓總額
  specialSubsidy    Int // 特案支援金額（可為 0）

  // 流程狀態
  status        String // DRAFT | PENDING_SUOZHANG | PENDING_BUZHUGUAN | APPROVED | REJECTED | WITHDRAWN
  submittedById String
  submittedBy   User     @relation("submitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())
  stepEnteredAt DateTime @default(now()) // 進入目前關卡的時間（逾期判斷用）
  updatedAt     DateTime @updatedAt

  category CaseCategory? @relation(fields: [categoryId], references: [id])
  logs     ApprovalLog[]

  // 本機 sqlite 保留這個 constraint（本機資料已清過重複，套用沒問題）；
  // 正式 schema.production.prisma 暫時拿掉了，因為正式 DB 還有重複資料沒清，
  // 兩份 schema 這裡刻意不同步，清完正式資料後要記得把正式那邊加回來
  @@unique([storeCode, deptCode, categoryId, categoryNo])
  @@index([status])
  @@index([storeCode])
  @@index([month])
}

// 審核／異動紀錄（稽核軌跡）
model ApprovalLog {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  step       String // SUBMIT | RESUBMIT | WITHDRAW | SUOZHANG | BUZHUGUAN
  action     String // SUBMIT | RESUBMIT | WITHDRAW | APPROVE | REJECT
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  comment    String? // 審核意見 / 駁回原因
  createdAt  DateTime @default(now())

  @@index([caseId])
}

// 特案類別主檔
model CaseCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  cases     Case[]
}

// 車種主檔
model CarModel {
  id        String  @id @default(cuid())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

// 月份開放/關閉設定
model MonthWindow {
  id      String    @id @default(cuid())
  month   String    @unique // YYYY-MM
  isOpen  Boolean   @default(true)
  openAt  DateTime?
  closeAt DateTime?
}

// 所課目標台數主檔：每月由後台整批上傳（覆蓋當月舊資料），逐所逐課設定比重與目標台數。
// deptCode="0" 代表「所層級」的獨立數值（業務編制沒有 0 課），不是靠加總底下各課算出來——
// 所目標與課目標各自獨立維護，互不連動。
model UnitTarget {
  id          String   @id @default(cuid())
  month       String // YYYY-MM
  storeCode   String // 所別
  deptCode    String // 課別；"0"="所層級"（無此課別編號）
  weight      Float // 比重（%）
  targetCount Int // 目標台數
  updatedAt   DateTime @updatedAt

  @@unique([month, storeCode, deptCode])
  @@index([month])
}

// ============================================================
// 配件變更申請系統（特仕車變更申請）— 獨立於特案支援金流程
// 申請方（所長 SUOZHANG／副所長 KEZHANG）上傳 OPT 工單照片＋填變更前後配件，
// 單層審核直接送部長（BUZHUGUAN），核准後蓋章寫入 Google Drive，
// 最後由配件中心（PEIJIAN）做明細確認。
// ============================================================

// 配件變更申請單
model AccessoryRequest {
  id     String @id @default(cuid())
  dataNo String @unique // 資料編號（OPT 訂單編號），全系統唯一
  month  String // 月份 YYYY-MM（送出時帶入，供 Drive 依月歸檔）

  // 以下欄位由 OCR 辨識填入、人工可覆核修改
  storeCode        String // 所別
  salesName        String // 業務姓名
  customerName     String // 客戶名稱
  carModel         String // 車名
  accessoryNameQty String // 配件名稱／數量（OPT 工單「名稱/數量」欄，辨識填入一大格，自由文字）

  // 人工填寫欄位
  deptCode          String? // 課別（課長自動帶出，所長可選。對應送單人的課別；課長為實際課別，所長為空視為「所層級」）
  accessoryBefore   String // 變更前配件
  accessoryAfter    String // 變更後配件
  changeDescription String // 更換說明

  // 送出時的警示旗標（金額數量>1 或說明含「不裝」「隨車」等字樣仍強行送出時，
  // 供審核方頁面顯示紅色警告）
  warningFlag Boolean @default(false)
  warningText String? // 觸發的警示內容

  // 流程狀態
  status        String // DRAFT | PENDING_REVIEW | REJECTED | APPROVED | CONFIRMED | WITHDRAWN
  submittedById String
  submittedBy   User     @relation("accSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())
  stepEnteredAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images AccessoryImage[]
  logs   AccessoryLog[]

  @@index([status])
  @@index([storeCode])
  @@index([month])
}

// 申請單附圖（可多張）：審核前把圖片 base64 直接暫存 DB，
// 核准後合成蓋章圖並寫入 Google Drive，寫入成功後清空 base64、只留 driveFileId。
model AccessoryImage {
  id          String           @id @default(cuid())
  requestId   String
  request     AccessoryRequest @relation(fields: [requestId], references: [id])
  mimeType    String // 影像 MIME（例如 image/jpeg）
  imageData   String? // 原始圖 base64（審核前暫存；寫入 Drive 後清空）
  stampedData String? // 蓋章後合成圖 base64（核准後暫存；寫入 Drive 後清空）
  driveFileId String? // 寫入 Google Drive 後的檔案 id
  ocrRaw      String? // OCR 原始回傳（JSON 字串，供覆核追溯）
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([requestId])
}

// 配件變更審核／異動紀錄（稽核軌跡）
model AccessoryLog {
  id         String           @id @default(cuid())
  requestId  String
  request    AccessoryRequest @relation(fields: [requestId], references: [id])
  step       String // SUBMIT | RESUBMIT | WITHDRAW | BUZHUGUAN | PEIJIAN | STAFF
  action     String // SUBMIT | RESUBMIT | WITHDRAW | APPROVE | REJECT | CONFIRM | RETURN
  reviewerId String
  reviewer   User             @relation("accReviewer", fields: [reviewerId], references: [id])
  comment    String?
  createdAt  DateTime         @default(now())

  @@index([requestId])
}

// 稽核紀錄：登入成功/失敗＋後台人員管理操作。最小版，先只寫入不做查詢介面，
// 出事時能查 DB 找出是誰做的即可
model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String? // 找得到有效使用者時填；登入失敗常常找不到（帳號打錯）
  actorUsername String? // 帳號字串留底，使用者被刪除／帳號打錯也查得到
  action        String // LOGIN_SUCCESS | LOGIN_FAIL | CREATE_USER | UPDATE_USER | DELETE_USER | TOGGLE_USER_ACTIVE | IMPORT_USERS
  targetType    String?
  targetId      String?
  summary       String?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
