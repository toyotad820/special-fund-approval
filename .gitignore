# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (本機 SQLite 資料庫)
prisma/dev.db
prisma/dev.db-journal
*.db

.vercel
.env*
# .env.example 是範本檔（只有 placeholder，無密鑰），刻意排除在上面的 .env* 規則外，
# 這樣 clone repo 的人才抓得到，README 的 cp .env.example .env 才有東西可複製
!.env.example
